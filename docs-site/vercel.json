{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/typesafe-sdk-dotnet/_astro/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/typesafe-sdk-dotnet",
      "destination": "/index.html"
    },
    {
      "source": "/typesafe-sdk-dotnet/",
      "destination": "/index.html"
    },
    {
      "source": "/typesafe-sdk-dotnet/:path*/",
      "destination": "/:path*/index.html"
    },
    {
      "source": "/typesafe-sdk-dotnet/:path*",
      "destination": "/:path*"
    }
  ]
}
