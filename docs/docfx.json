{
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": ["**/TypeSafe.AI.Sdk.csproj"]
        }
      ],
      "dest": "api",
      "filter": "filterConfig.yml",
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": ["api/**.yml", "api/index.md"]
      },
      {
        "files": ["articles/**.md", "articles/**/toc.yml", "toc.yml", "*.md"]
      }
    ],
    "resource": [
      {
        "files": ["images/**"]
      }
    ],
    "overwrite": [
      {
        "files": ["apidoc/**.md"],
        "exclude": ["obj/**", "_site/**"]
      }
    ],
    "dest": "_site",
    "template": ["default", "modern", "templates/custom"],
    "globalMetadata": {
      "_appTitle": "TypeSafe.AI.Sdk",
      "_appName": "TypeSafe.AI.Sdk",
      "_appFooter": "MIT · Copyright (c) Dario Kondratiuk. · not affiliated with TypeSafe beyond being a client of the public API",
      "_enableSearch": true,
      "_enableNewTab": true,
      "_gitContribute": {
        "repo": "https://github.com/hardkoded/typesafe-sdk-dotnet",
        "branch": "main"
      }
    },
    "markdownEngineName": "markdig",
    "sitemap": {
      "baseUrl": "https://hardkoded.github.io/typesafe-sdk-dotnet",
      "priority": 0.5,
      "changefreq": "weekly"
    }
  }
}
